export LANG="en_US.UTF-8"

# history
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
unsetopt share_history # don't share history between sessions

setopt extended_history # save the time stamp and duration of each command
setopt inc_append_history_time # write each command to the file once it finishes
setopt hist_ignore_dups # don't record a command repeated right after itself
setopt hist_ignore_space # don't record commands that start with a space
setopt interactivecomments # allow comments in interactive shell

# colored ls (BSD ls on macOS only colors when this is set)
export CLICOLOR=1

# completions (brew site-functions + zsh-completions)
fpath=(/opt/homebrew/share/zsh/site-functions /opt/homebrew/share/zsh-completions $fpath)
# Перестраиваем дамп раз в сутки, иначе грузим готовый кэш (-C) без медленной
# проверки безопасности fpath. glob раскрываем через массив — в [[ -n ]] генерации имён нет.
autoload -Uz compinit
_zcd=${ZDOTDIR:-$HOME}/.zcompdump
_zcd_stale=( $_zcd(N.mh+24) )
if (( $#_zcd_stale )); then
  compinit -u -d "$_zcd"
else
  compinit -C -u -d "$_zcd"
fi
unset _zcd _zcd_stale

# Run 'ls' after 'cd'
autoload -Uz add-zsh-hook
function chpwd_ls {
    ls
}
add-zsh-hook chpwd chpwd_ls

export PATH="$HOME/.local/bin:$PATH"
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"
export PATH="/opt/homebrew/opt/node@22/bin:$PATH"  # node@22 is keg-only (pinned to match CI)
export CPPFLAGS="-I/opt/homebrew/include"
export LDFLAGS="-L/opt/homebrew/lib"

export HOMEBREW_NO_ENV_HINTS=1
export GPG_TTY=$(tty)

# nx: no cloud prompts, non-interactive
export NX_NO_CLOUD=true
export NX_INTERACTIVE=false

# jira-cli: pull the API token from the macOS Keychain only for the duration of
# the call, so it never sits in every shell's env. Store/update the token with:
#   security add-generic-password -a "$USER" -s jira-cli-token -w [-U]
jira() {
  JIRA_API_TOKEN="$(security find-generic-password -s jira-cli-token -w 2>/dev/null)" \
    command jira "$@"
}

# gjust: run the global justfile (~/.config/just/justfile) from ANY directory,
# executing in the current dir. Plain `just` still uses the nearest local
# justfile — this is a separate command so the two never clash.
gjust() { just --justfile "$HOME/.config/just/justfile" --working-directory "$PWD" "$@"; }

# Completion for gjust: reuse just's clap completer, but resolved against the
# global justfile (inject `--justfile <path>` into the words just sees).
_gjust() {
  (( $+functions[_clap_dynamic_completer_just] )) || source <(JUST_COMPLETE=zsh just 2>/dev/null)
  words[1,1]=(just --justfile "$HOME/.config/just/justfile")
  (( CURRENT += 2 ))
  _clap_dynamic_completer_just "$@"
}
compdef _gjust gjust

eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
# fzf: ctrl+r searches history, ctrl+t inserts a file path, alt+c cd's into a dir
source <(fzf --zsh)

# shell plugins from homebrew — zsh-syntax-highlighting goes after everything
# except history-substring-search, which must be loaded after it
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /opt/homebrew/share/zsh-you-should-use/you-should-use.plugin.zsh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source /opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh

# up/down: walk through history entries that contain what's typed so far
# (both escape forms — the terminal switches between them)
bindkey '^[[A' history-substring-search-up
bindkey '^[OA' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^[OB' history-substring-search-down
