#!/bin/bash
# Deliberately `copy`, not `sync`: an accidental delete on the host must never reach the
# offsite copy. The remote therefore keeps files removed here — prune it by hand when it
# grows too big. Managed by Ansible (roles/backup).
set -e

/usr/bin/rclone copy /mnt/ssd/photos keenetic:/backup/photos --log-file={{ logs_dir }}/keenetic.log --log-level=INFO --transfers=8 --size-only
/usr/bin/rclone copy /mnt/ssd/photos-upload/library keenetic:/backup/library --log-file={{ logs_dir }}/keenetic-library.log --log-level=INFO --transfers=8 --size-only
