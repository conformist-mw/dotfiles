{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Kyiv",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "ignorePaths": ["roles/outdated/**", "roles/watchtower/**"],
  "kubernetes": {
    "managerFilePatterns": ["k8s/*.yaml", "k8s/**/*.yaml"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "image refs held in role defaults as *_image vars",
      "managerFilePatterns": ["roles/*/defaults/main.yml"],
      "matchStrings": ["_image:\\s*\"(?<depName>[^\"\\s:]+):(?<currentValue>[^\"\\s]+)\""],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "own images: :latest or sha- tags, no versions to compare",
      "matchPackageNames": ["olegsmedyuk/**", "ghcr.io/conformist-mw/**"],
      "enabled": false
    }
  ]
}
